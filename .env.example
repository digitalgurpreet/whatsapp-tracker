# Secret string you configure in the Meta Developer Portal webhook settings.
# The GET /webhook handshake must present this exact value.
VERIFY_TOKEN=your_secret_verify_token_here

# SQLAlchemy database URL.
# Local: sqlite:///./whatsapp_chats.db
# Cloud: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=sqlite:///./whatsapp_chats.db

# Port used when launching via `python main.py`. The README uvicorn command also passes --port.
PORT=8000

# Required to send outbound replies via POST /send (and log them with full text).
# Copy the temporary access token from WhatsApp → API setup, or a permanent system user token.
WHATSAPP_TOKEN=
# Phone number ID from WhatsApp → API setup (not the display number).
WHATSAPP_PHONE_NUMBER_ID=
# Display number in digits, e.g. 917986341955. Used as from_phone on outbound rows.
WHATSAPP_DISPLAY_PHONE=
GRAPH_API_VERSION=v25.0
